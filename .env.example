ENVIRONMENT=local
DEBUG=True

# Comma-separated list of origins allowed to make cross-origin requests to this API
CORS_ALLOWED_ORIGINS=http://localhost:3000

# All credentials live cleanly inside this single URL string
ASSIMILATION_DATABASE_URL=mssql+pyodbc://sa:YourStrongPassword123@localhost:1433/mydb?driver=ODBC+Driver+18+for+SQL+Server

# Time (seconds) to establish a new connection to SQL Server before giving up
DB_CONNECT_TIMEOUT_SECONDS=5
# Time (seconds) a single query is allowed to run before SQL Server aborts it
DB_QUERY_TIMEOUT_SECONDS=30
# Time (seconds) a request waits for a free connection from the pool
DB_POOL_TIMEOUT_SECONDS=30
# Max age (seconds) of a pooled connection before it's recycled
DB_POOL_RECYCLE_SECONDS=1800

# --- Connection pool sizing ---
# Total connections a single process can hold open against SQL Server is
# DB_POOL_SIZE + DB_MAX_OVERFLOW. Once this runs as multiple containers or
# multiple WORKERS (see below), the real ceiling against SQL Server is:
#   (WORKERS x replica count) x (DB_POOL_SIZE + DB_MAX_OVERFLOW)
# This DB is shared with the existing church web app, so that ceiling has to
# stay comfortably under whatever headroom SQL Server actually has left, not
# just under its hard connection limit.
# Connections kept open per process even when idle
DB_POOL_SIZE=5
# Extra connections allowed beyond DB_POOL_SIZE under burst load; closed
# (not kept) once the burst is over
DB_MAX_OVERFLOW=5
# Ping a pooled connection before handing it out, so a connection SQL Server
# silently closed is replaced instead of failing the request that draws it
DB_POOL_PRE_PING=True
# Hand out the most-recently-returned connection first (LIFO) instead of
# round-robin, so a small working set stays warm under light/bursty load
DB_POOL_USE_LIFO=True

# Port the production server (run.py) binds to
PORT=8000

# Uvicorn worker processes for run.py. Each worker is a separate process with
# its own DB connection pool (see the pool-sizing note above) and its own
# in-memory rate-limiter counters, so a "10/minute" limit becomes effectively
# "10 x WORKERS per minute". Once deployed behind an orchestrator (ECS/K8s),
# prefer scaling via replica count and leave this at 1.
WORKERS=1

# Wall-clock cap (seconds) on handling a single API request
REQUEST_TIMEOUT_SECONDS=30
# How long (seconds) an idle keep-alive connection stays open
KEEP_ALIVE_TIMEOUT_SECONDS=5
# How long (seconds) in-flight requests get to finish on shutdown (e.g. SIGTERM)
GRACEFUL_SHUTDOWN_TIMEOUT_SECONDS=30

# Rate limit applied per client IP, per process (slowapi syntax, e.g.
# "60/minute"). In-memory, not shared across WORKERS or replicas -- see the
# warning in rate_limit.py. Effectively becomes "<value> x (workers x
# replicas)" once either goes above 1.
DEFAULT_RATE_LIMIT=60/minute

# Max simultaneous connections uvicorn accepts before returning 503 to new
# ones. Leave commented out for unlimited (uvicorn's own default) -- an
# empty value here will fail to parse as an int.
# LIMIT_CONCURRENCY=100
# Max pending TCP connections queued once capacity is saturated, before
# refusing new ones outright. 2048 matches uvicorn's own default.
BACKLOG=2048

# Max sync ("def", not "async def") route handlers/dependencies allowed to
# run concurrently per process -- these run on a thread pool, not the
# asyncio event loop ("async def" routes bypass this entirely). 40 matches
# anyio's own default. Per process, same caveat as DB_POOL_SIZE/
# DB_MAX_OVERFLOW above: multiply by (workers x replicas) for the real
# total. If this is smaller than DB_POOL_SIZE + DB_MAX_OVERFLOW, this
# becomes the binding concurrency limit for sync DB-backed routes instead
# of the DB pool. Unlike LIMIT_CONCURRENCY/BACKLOG/WORKERS, this one is
# applied inside the app itself (not passed to uvicorn), so it takes
# effect under `fastapi dev` too, not just run.py.
THREAD_POOL_SIZE=40